    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="[10.0.8]" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="[8.23.0]" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="[8.23.0]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Libraries\Clients\Clients.csproj" />
    <ProjectReference Include="..\Libraries\GlobalSettingsBridge\GlobalSettingsBridge.csproj" />
    <ProjectReference Include="..\Libraries\Push.Infrastructure\Push.Infrastructure.csproj" />
    <ProjectReference Include="..\Libraries\SerilogFileLogging\SerilogFileLogging.csproj" />
  </ItemGroup>

  <ItemGroup>
