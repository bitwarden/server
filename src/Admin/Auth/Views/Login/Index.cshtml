@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        @if(!string.IsNullOrWhiteSpace(Model.Success))
        {
            <div class="alert alert-success" role="alert">@Model.Success</div>
        }
        else if(!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="alert alert-danger" role="alert">@Model.Error</div>
        }
        <div class="card">
            <div class="card-body">
                <p>Please enter your email address below to log in.</p>
                <form asp-action="" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Email" class="visually-hidden">Email Address</label>
                        <div class="d-flex gap-2">
                            <input asp-for="Email" type="email" class="form-control"
                                   placeholder="ex. john@example.com" required autofocus
                                   id="email-input">
                            <button class="btn btn-primary flex-shrink-0" type="submit" id="email-submit" disabled>
                                Continue
                            </button>
                        </div>
                        <span asp-validation-for="Email" class="invalid-feedback"></span>
                        <div class="form-text">We'll email you a secure login link.</div>
                    </div>
                </form>
                @if (Model.SsoEnabled)
                {
                    <hr />
                    <a class="btn btn-outline-primary w-100"
                       asp-controller="Login"
                       asp-action="Sso"
                       asp-route-returnUrl="@Model.ReturnUrl">
                        Sign in with @(string.IsNullOrWhiteSpace(Model.SsoDisplayName) ? "SSO" : Model.SsoDisplayName)
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('email-input');
            var button = document.getElementById('email-submit');
            if (!input || !button) return;
            var sync = function () { button.disabled = input.value.trim().length === 0; };
            input.addEventListener('input', sync);
            sync();
        })();
    </script>
}
