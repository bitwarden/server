@using Bit.Admin.Enums
@using Bit.Core.AdminConsole.Enums.Partnerships
@inject Bit.Admin.Services.IAccessControlService AccessControlService
@inject Bit.Core.Settings.GlobalSettings GlobalSettings
@model OrganizationViewModel
@{
    var canEditPartnership = !GlobalSettings.SelfHosted
                               && AccessControlService.UserHasPermission(Permission.Org_Plan_Edit);
}

<h2>Partnership</h2>
@if (Model.Partnership != null)
{
    <dl class="row">
        <dt class="col-sm-4 col-lg-3">Name</dt>
        <dd id="partnership-name" class="col-sm-8 col-lg-9">@Model.Partnership.Name</dd>

        <dt class="col-sm-4 col-lg-3">Status</dt>
        <dd id="partnership-status" class="col-sm-8 col-lg-9">@Model.Partnership.Status</dd>

        <dt class="col-sm-4 col-lg-3">Allowed sponsored plan types</dt>
        <dd id="partnership-allowed-sponsored-plan-types" class="col-sm-8 col-lg-9">@string.Join(", ", Model.Partnership.GetAllowedSponsoredPlanTypes())</dd>

        <dt class="col-sm-4 col-lg-3">Binding mode</dt>
        <dd id="partnership-binding-mode" class="col-sm-8 col-lg-9">@Model.Partnership.BindingMode</dd>

        <dt class="col-sm-4 col-lg-3">Registered return origins</dt>
        <dd id="partnership-return-origins" class="col-sm-8 col-lg-9">
            @{ var origins = Model.Partnership.GetRegisteredReturnOrigins().ToList(); }
            @if (origins.Count == 0)
            {
                <span>-</span>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var origin in origins)
                    {
                        <li><code>@origin</code></li>
                    }
                </ul>
            }
        </dd>

        <dt class="col-sm-4 col-lg-3">Created</dt>
        <dd id="partnership-creation-date" class="col-sm-8 col-lg-9">@Model.Partnership.CreationDate.ToString()</dd>
    </dl>
    @if (canEditPartnership)
    {
        @if (Model.Partnership.Status == PartnershipStatus.Active)
        {
            <form asp-controller="OrganizationPartnerships" asp-action="Deactivate"
                  asp-route-organizationId="@Model.Organization.Id" method="post" class="mb-3"
                  onsubmit="return confirm('Deactivate this partnership? The partner will not be able to provision or change entitlements until it is reactivated.')">
                <button id="partnership-deactivate" type="submit" class="btn btn-outline-danger">Deactivate partnership</button>
            </form>
        }
        else
        {
            <form asp-controller="OrganizationPartnerships" asp-action="Reactivate"
                  asp-route-organizationId="@Model.Organization.Id" method="post" class="mb-3">
                <button id="partnership-reactivate" type="submit" class="btn btn-secondary">Reactivate partnership</button>
            </form>
        }
    }
}
else
{
    <p>This organization has no partnership.</p>
    @if (canEditPartnership)
    {
        <a asp-controller="OrganizationPartnerships" asp-action="Create"
           asp-route-organizationId="@Model.Organization.Id"
           class="btn btn-secondary mb-3">Create partnership</a>
    }
}
