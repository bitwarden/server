<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!--
        MSBuildLocator must run before any MSBuild type loads, so Program calls it first.
        Workspaces.MSBuild opens the solution and carries each project's analyzer references,
        which is where this tool gets the analyzer from.
    -->
    <PackageReference Include="Microsoft.Build.Locator" Version="[1.11.2]" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="[5.9.0]" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="[5.9.0]" />
    <!--
        MSBuild's own assemblies must load from the installed SDK at runtime, not from NuGet, or
        the workspace fails once it opens. Pinned with runtime assets excluded for that reason.
    -->
    <PackageReference Include="Microsoft.Build.Framework" Version="[17.11.48]" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
        The baseline document format and the observation wire format. Version comes from
        Directory.Build.props so this tool and the analyzer the build runs can never be out of
        step, which would quietly produce the wrong baselines.
    -->
    <PackageReference Include="Bitwarden.Server.Sdk.RestrictedDependencies" Version="$(BitwardenRestrictedDependenciesVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RestrictedDependencyBaselines.Test" />
  </ItemGroup>

</Project>
