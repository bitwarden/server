<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <Version>2026.9.1</Version>

    <RootNamespace>Bit.$(MSBuildProjectName)</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject Condition="'$(IsTestProject)' == '' and ($(MSBuildProjectName.EndsWith('.Test')) or $(MSBuildProjectName.EndsWith('.IntegrationTest')))">true</IsTestProject>
    <Nullable Condition="'$(Nullable)' == '' and '$(IsTestProject)' == 'true'">annotations</Nullable>
    <Nullable Condition="'$(Nullable)' == '' and '$(IsTestProject)' != 'true'">enable</Nullable>
    <TreatWarningsAsErrors Condition="'$(TreatWarningsAsErrors)' == ''">true</TreatWarningsAsErrors>
    <!--
        BWA0001: soft-deprecation of the (Bit.Core.Models.Api.ResponseModel and Bit.Api.Models.Response.ListResponseModel)
         in favor Bit.HttpExtensions. Keep it a warning (not an error) so existing consumers build while we migrate them.
        BWA0002: soft-deprecation of the legacy IFeatureService and this exclusion will go way once everyone migrates to the SDK one
        BW0011: an expired [RestrictedDependencyException] warns rather than failing the build, so a lapsed expiry blocks nobody's unrelated work
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);BWA0001;BWA0002;BW0011</WarningsNotAsErrors>
    <NuGetAuditLevel>critical</NuGetAuditLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!--
      Restricted dependencies. Production projects under src/ compile with the
      Bitwarden.Server.Sdk.RestrictedDependencies analyzer and the committed baselines in
      util/RestrictedDependencies/baselines; tests, util, perf, AppHost and the sqlproj do not.
      util/RestrictedDependencies/RestrictedDependencyBaselines selects projects by the same rule.

      The package's build assets declare which of these properties the compiler may see, and glob
      the baselines in as marked AdditionalFiles.
  -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <_RestrictedDependencyProjectPath>$([MSBuild]::MakeRelative('$(RepoRoot)', '$(MSBuildProjectFullPath)').Replace('\', '/'))</_RestrictedDependencyProjectPath>
    <RestrictedDependencyAnalysis Condition="'$(RestrictedDependencyAnalysis)' == '' and '$(MSBuildProjectExtension)' == '.csproj' and $(_RestrictedDependencyProjectPath.StartsWith('src/'))">true</RestrictedDependencyAnalysis>
    <RestrictedDependencyAnalysis Condition="'$(RestrictedDependencyAnalysis)' == ''">false</RestrictedDependencyAnalysis>
    <RestrictedDependencyBaselinesPath Condition="'$(RestrictedDependencyAnalysis)' == 'true'">$(RepoRoot)util/RestrictedDependencies/baselines</RestrictedDependencyBaselinesPath>
    <RestrictedDependencyUpdateCommand Condition="'$(RestrictedDependencyAnalysis)' == 'true'">dotnet run --project util/RestrictedDependencies/RestrictedDependencyBaselines -- update</RestrictedDependencyUpdateCommand>
    <BitwardenRestrictedDependenciesVersion>0.1.0-demo.2</BitwardenRestrictedDependenciesVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(RestrictedDependencyAnalysis)' == 'true'">
    <!--
        Build-time only. PrivateAssets keeps it from flowing to dependents, which otherwise records
        it as a transitive dependency in every test and util project's lock file.
    -->
    <PackageReference Include="Bitwarden.Server.Sdk.RestrictedDependencies" Version="$(BitwardenRestrictedDependenciesVersion)" IncludeAssets="analyzers;build" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <BitIncludeAuthentication>false</BitIncludeAuthentication>
  </PropertyGroup>

  <PropertyGroup>

    <MicrosoftNetTestSdkVersion>18.0.1</MicrosoftNetTestSdkVersion>

    <XUnitVersion>2.6.6</XUnitVersion>

    <XUnitRunnerVisualStudioVersion>2.5.6</XUnitRunnerVisualStudioVersion>

    <CoverletCollectorVersion>6.0.0</CoverletCollectorVersion>

    <NSubstituteVersion>5.1.0</NSubstituteVersion>

    <AutoFixtureXUnit2Version>4.18.1</AutoFixtureXUnit2Version>

    <AutoFixtureAutoNSubstituteVersion>4.18.1</AutoFixtureAutoNSubstituteVersion>
  </PropertyGroup>
</Project>
