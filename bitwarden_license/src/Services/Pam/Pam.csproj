<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bit.Services.Pam</RootNamespace>
    <!-- Emit XML docs so PAM request and response model descriptions flow into the generated OpenAPI spec. Missing-doc
         warnings (1591/1573) are suppressed as in Core.csproj, since warnings are errors. -->
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <NoWarn>1701;1702;1591;1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Core\Core.csproj" />
    <ProjectReference Include="..\..\..\..\src\HttpExtensions\HttpExtensions.csproj" />
    <ProjectReference Include="..\..\..\..\src\Libraries\OrganizationAuthorization\OrganizationAuthorization.csproj" />
    <ProjectReference Include="..\..\..\..\src\Pam.Domain\Pam.Domain.csproj" />
  </ItemGroup>

</Project>
